# المفاتيح الظاهرة هنا هي المفاتيح العامة فقط (anon / publishable)
# ممنوع نهائيًا وضع service_role key في أي ملف هنا
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# مفتاح الموقع من Cloudflare Turnstile (اختياري للتطوير المحلي، ضروري في الإنتاج)
VITE_TURNSTILE_SITE_KEY=
