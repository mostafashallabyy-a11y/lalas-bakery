# Dependencies
node_modules/

# Build output
dist/

# Environment variables — NEVER commit real keys
.env
.env.local
.env.*.local

# OS / editor noise
.DS_Store
Thumbs.db

# Backup dumps (never commit DB dumps)
backups/
*.dump
*.sql.gz

# Local secrets (rotated passwords etc.) — never commit
scripts/local/

# Supabase CLI link metadata (never commit)
supabase/.temp/

# Playwright / test artifacts
test-results/
playwright-report/

# Lighthouse reports (محلية — النتايج بتتكتب في التقرير)
lighthouse-menu*.json
lighthouse-*.html

# لقطات الشاشة الأصلية ثقيلة — بنحفظ نسخة WebP مضغوطة بس
screenshots/**/*.png
